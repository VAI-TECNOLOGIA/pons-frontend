{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://web-production-e420b.up.railway.app/api/:path*"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade/index.html"
    },
    {
      "source": "/termos",
      "destination": "/termos/index.html"
    },
    {
      "source": "/suporte",
      "destination": "/suporte/index.html"
    },
    {
      "source": "/((?!api/|privacidade|termos|suporte).*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite"
}
