{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://web-production-e420b.up.railway.app/api/:path*"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade/index.html"
    },
    {
      "source": "/termos",
      "destination": "/termos/index.html"
    },
    {
      "source": "/suporte",
      "destination": "/suporte/index.html"
    },
    {
      "source": "/((?!api/|assets/|privacidade|termos|suporte).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!assets/|api/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "framework": "vite"
}
